@@ a7  src/net.ts:16-28
+
+export async function retryWithBackoff<T>(fn: () => Promise<T>, attempts = 3): Promise<T> {
+  let delay = 100;
+  for (let attempt = 1; ; attempt++) {
+    try {
+      return await fn();
+    } catch (failure) {
+      if (attempt >= attempts) throw failure;
+      await new Promise((wake) => setTimeout(wake, delay));
+      delay *= 2;
+    }
+  }
+}

