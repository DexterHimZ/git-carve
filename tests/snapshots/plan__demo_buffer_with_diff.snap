@@ a18  tests/net.test.ts:7-16
+
+export async function testRetryWithBackoff(): Promise<boolean> {
+  let calls = 0;
+  const outcome = await retryWithBackoff(async () => {
+    calls += 1;
+    if (calls < 2) throw new Error("flaky");
+    return "ok";
+  });
+  return outcome === "ok" && calls === 2;
+}

