{
  "name": "git-carve",
  "version": "0.0.0",
  "description": "Turns a branch, yours or your agent's, into commits or a stack of PRs that each pass your check before you push.",
  "license": "MIT OR Apache-2.0",
  "bin": {
    "git-carve": "bin/git-carve.js"
  },
  "files": [
    "bin/git-carve.js",
    "README.md"
  ],
  "optionalDependencies": {
    "@git-carve/linux-x64": "0.0.0",
    "@git-carve/linux-arm64": "0.0.0",
    "@git-carve/darwin-x64": "0.0.0",
    "@git-carve/darwin-arm64": "0.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": ["git", "commit", "split", "typescript", "tsc"]
}
